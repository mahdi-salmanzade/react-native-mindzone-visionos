# Resolve the same fork root used by the CLI and Metro, including hoisted installs.
react_native_path = File.dirname(Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native-mindzone-visionos/package.json", {paths: [process.argv[1]]})',
  __dir__]).strip)
require File.join(react_native_path, 'scripts/react_native_pods.rb')

# React.xcframework has no xros slice. Keep supported Hermes/dependency prebuilts.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
platform :visionos, min_visionos_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HelloWorld' do
  use_native_modules!
  use_react_native!(
    :path => react_native_path,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'HelloWorldTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      react_native_path,
      :mac_catalyst_enabled => false
    )
  end
end
